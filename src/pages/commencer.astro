---
import Newsletter from "../components/footer/Newsletter.astro";
import BigTitle from "../components/ui/BigTitle";
import SmallTitle from "../components/ui/SmallTitle";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <section class="bg-gray-50 py-20 px-4 md:px-8 max-w-7xl mx-auto">
    <!-- En-tête de la section -->
    <div class="text-center mb-16">
      <BigTitle className="mt-8"> Mindlet est en phase de maintenance </BigTitle>
      <div class="w-full max-w-3xl mx-auto">
        <div class="h-1 w-48 bg-emerald-500 mx-auto rounded-full"></div>
      </div>
      <p class="text-lg text-gray-600 mt-6 max-w-2xl mx-auto">
        Suite aux retours de la beta, nous ajustons et améliorons l'application pour préparer le lancement officiel en mai 2026.
      </p>
    </div>

    <!-- Points de progression -->
    <div class="mt-24 max-w-4xl mx-auto">
      <SmallTitle className="text-center"> Notre progression </SmallTitle>

      <div class="relative">
        <!-- Ligne de progression -->
        <div class="absolute top-5 inset-x-0 h-1 bg-gray-200"></div>
        <div class="absolute top-5 left-0 h-1 bg-emerald-500 w-3/4"></div>

        <!-- Étapes -->
        <div class="flex justify-between relative">
          <!-- Étape 1 - Terminée -->
          <div class="relative z-10 text-center">
            <div
              class="w-10 h-10 bg-emerald-500 rounded-full mx-auto flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <p class="mt-2 text-sm font-medium text-gray-700">Conception</p>
          </div>

          <!-- Étape 2 - Terminée -->
          <div class="relative z-10 text-center">
            <div
              class="w-10 h-10 bg-emerald-500 rounded-full mx-auto flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <p class="mt-2 text-sm font-medium text-gray-700">Développement</p>
          </div>

          <!-- Étape 3 - Terminée (Beta) -->
          <div class="relative z-10 text-center">
            <div
              class="w-10 h-10 bg-emerald-500 rounded-full mx-auto flex items-center justify-center"
            >
              <svg
                class="w-5 h-5 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <p class="mt-2 text-sm font-medium text-gray-700">Test Beta</p>
          </div>

          <!-- Étape 4 - En cours (Maintenance) -->
          <div class="relative z-10 text-center">
            <div
              class="w-10 h-10 bg-emerald-100 border-2 border-emerald-500 rounded-full mx-auto flex items-center justify-center"
            >
              <span class="bg-emerald-500 animate-pulse w-5 h-5 rounded-full"></span>
            </div>
            <p class="mt-2 text-sm font-medium text-emerald-600">Maintenance</p>
          </div>

          <!-- Étape 5 - À venir (Lancement) -->
          <div class="relative z-10 text-center">
            <div
              class="w-10 h-10 bg-gray-100 rounded-full mx-auto flex items-center justify-center"
            >
              <span class="text-gray-400 font-medium">5</span>
            </div>
            <p class="mt-2 text-sm font-medium text-gray-400">Lancement</p>
          </div>
        </div>
      </div>

      <div class="text-center mt-10">
        <p class="text-emerald-600 font-medium">Phase de maintenance et ajustements en cours</p>
        <p class="text-gray-600 text-sm mt-2">Nous intégrons les retours de la beta pour peaufiner l'application. Lancement officiel prévu en mai 2026.</p>
      </div>
    </div>

    <!-- Section Newsletter pour les retours -->
    <div class="mt-16 text-center max-w-3xl mx-auto">
      <div class="bg-gray-100 rounded-xl p-8">
        <h3 class="text-xl font-semibold text-gray-800 mb-4">Restez informé des mises à jour</h3>
        <p class="text-gray-600 mb-6">Inscrivez-vous à notre newsletter pour recevoir les dernières nouvelles et améliorer l'application avec nous !</p>
        <Newsletter />
      </div>
    </div>
  </section>
</Layout>
